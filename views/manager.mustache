<!DOCTYPE html>
<html>
<head>
  <title>Manager Dashboard - The Rolling Die</title>
</head>
<body>
  <h1>Manager Dashboard</h1>
  <p>Logged in as {{username}} | <a href="/logout">Log out</a></p>

  <p><a href="/manager/add">+ Add a game</a></p>

  <table border="1" cellpadding="6">
    <tr>
      <th>Title</th>
      <th>Category</th>
      <th>Price</th>
      <th>Stock</th>
      <th>Actions</th>
    </tr>
    {{#games}}
    <tr>
      <td>{{title}}</td>
      <td>{{category}}</td>
      <td>${{price}}</td>
      <td>{{stock}}</td>
      <td>
        <a href="/manager/edit/{{id}}">Edit</a>
        <form method="POST" action="/manager/delete/{{id}}" style="display: inline;"
              onsubmit="return confirm('Delete {{title}}?');">
          <button type="submit">Delete</button>
        </form>
      </td>
    </tr>
    {{/games}}
    {{^games}}
    <tr><td colspan="5">No games yet. Add one above.</td></tr>
    {{/games}}
  </table>

  <h2>Live Bot Activity</h2>
  <ul id="activity">
    <li id="no-activity">No bot activity yet.</li>
  </ul>

  <!-- socket.io serves this file automatically -->
  <script src="/socket.io/socket.io.js"></script>
  <script>
    const socket = io();

    // Runs every time the server sends a 'botactivity' message
    socket.on('botactivity', (data) => {
      const empty = document.getElementById('no-activity');
      if (empty) {
        empty.remove();
      }

      const item = document.createElement('li');
      item.textContent = data.time + ' - ' + data.user + ' used ' + data.command;

      // Newest at the top
      const list = document.getElementById('activity');
      list.prepend(item);
    });
  </script>
</body>
</html>