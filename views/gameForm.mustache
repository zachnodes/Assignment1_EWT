<!DOCTYPE html>
<html>
<head>
  <title>{{heading}} - The Rolling Die</title>
</head>
<body>
  <h1>{{heading}}</h1>

  {{#error}}
  <p style="color: red;">{{error}}</p>
  {{/error}}

  <!-- Used for both Add and Edit. On Edit, the fields are filled in with the current values. -->
  <form method="POST" action="{{action}}">
    <p>
      <label>Title<br>
        <input type="text" name="title" value="{{game.title}}" required>
      </label>
    </p>
    <p>
      <label>Category<br>
        <input type="text" name="category" value="{{game.category}}">
      </label>
    </p>
    <p>
      <label>Price<br>
        <input type="number" name="price" step="0.01" min="0" value="{{game.price}}" required>
      </label>
    </p>
    <p>
      <label>Stock<br>
        <input type="number" name="stock" min="0" value="{{game.stock}}" required>
      </label>
    </p>
    <p>
      <label>Min players<br>
        <input type="number" name="min_players" min="1" value="{{game.min_players}}">
      </label>
    </p>
    <p>
      <label>Max players<br>
        <input type="number" name="max_players" min="1" value="{{game.max_players}}">
      </label>
    </p>
    <p>
      <label>Description<br>
        <textarea name="description" rows="4" cols="40">{{game.description}}</textarea>
      </label>
    </p>
    <button type="submit">Save</button>
    <a href="/manager">Cancel</a>
  </form>
</body>
</html>